{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manifest",
  "description": "Common manifest schema for pipeline stage hand-offs.",
  "type": "object",
  "required": [
    "doc_id",
    "source_file",
    "department",
    "status",
    "timestamp",
    "parse_errors"
  ],
  "properties": {
    "doc_id": { "type": "string" },
    "source_file": { "type": "string" },
    "department": { "type": "string" },
    "status": { "type": "string" },
    "timestamp": { "type": "string" },
    "parse_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stage": {
      "type": "string",
      "enum": ["parser", "chunker", "embedder", "indexer"]
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0
    },
    "embedding_model": { "type": "string" },
    "embedding_dim": {
      "type": "integer",
      "minimum": 1
    },
    "vector_count": {
      "type": "integer",
      "minimum": 0
    },
    "kb_run_id": { "type": "string" },
    "collection_name": { "type": "string" },
    "upsert_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
