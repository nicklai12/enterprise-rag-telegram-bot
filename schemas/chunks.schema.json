{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chunks",
  "description": "Content of data/chunks/{doc_id}.json.",
  "type": "object",
  "required": [
    "doc_id",
    "source_file",
    "department",
    "chunks"
  ],
  "properties": {
    "doc_id": { "type": "string" },
    "source_file": { "type": "string" },
    "department": { "type": "string" },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_index",
          "text",
          "metadata"
        ],
        "properties": {
          "chunk_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": { "type": "string" },
          "metadata": {
            "type": "object",
            "required": [
              "source_file",
              "department"
            ],
            "properties": {
              "source_file": { "type": "string" },
              "department": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
