{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PendingQueue",
  "description": "Output of doc_classifier.py: a queue of documents and their processing decisions.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "doc_id",
      "source_file",
      "department",
      "decision"
    ],
    "properties": {
      "doc_id": { "type": "string" },
      "source_file": { "type": "string" },
      "department": { "type": "string" },
      "decision": {
        "type": "string",
        "enum": ["auto_process", "needs_review"]
      },
      "reason": { "type": "string" }
    },
    "additionalProperties": false
  }
}
